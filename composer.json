{
    "name": "dominservice/data_locale_parser",
    "type": "library",
    "description": "Data Locale Parser is a package for Laravel 9 | 10 | 11 | 12 | 13, which lists all countries, currencies and languages, with names and ISO 3166 codes in all languages and data formats.",
    "keywords": ["laravel", "php", "currencies", "languages", "countries", "data parser", "country list", "currencies list", "languages list", "umpirsky"],
    "homepage": "https://github.com/dominservice/data_locale_parser",
    "license": "MIT",
    "authors": [
        {
            "name": "dominservice",
            "email": "biuro@dso.biz.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0.2",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "arcreative/php-address-format": "^0.0.2"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Dominservice\\DataLocaleParser\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Dominservice\\DataLocaleParser\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:report": "@php tests/run-tests.php",
        "test:snapshots:record": "@php tests/record-snapshots.php build/snapshots/current",
        "test:snapshots:update": "@php tests/record-snapshots.php --update",
        "data:build": "@php tools/data-builder/build.php --replace",
        "data:validate": "@php tools/data-builder/validate.php",
        "data:publish": "@php tools/data-builder/publish.php",
        "data:benchmark": "@php tools/benchmark-data.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dominservice\\DataLocaleParser\\DataLocaleParserServiceProvider"
            ]
        }
    }
}
