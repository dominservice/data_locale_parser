    "exceptions": {
        "country": {
            "class": "Dominservice\\DataLocaleParser\\Exceptions\\CountryNotFoundException",
            "message": "Country 'ZZ' not found.",
            "code": 0
        },
        "currency": {
            "class": "Dominservice\\DataLocaleParser\\Exceptions\\CurrencyNotFoundException",
            "message": "Currency 'ZZZ' not found.",
            "code": 0
        },
        "language": {
            "class": "Dominservice\\DataLocaleParser\\Exceptions\\LanguageNotFoundException",
            "message": "Language '__missing__' not found.",
            "code": 0
        },
        "locale": {
            "class": "RuntimeException",
            "message": "Unable to load the country data file \"<package>/data/country/__missing__/country.php\"",
            "code": 0
        },
        "type": {
            "class": "ErrorException",
            "message": "Undefined property: Dominservice\\DataLocaleParser\\DataParser::$__missing__Dir",
            "code": 0
        }
    },
    "custom_lists": {
        "fluent_return": true,
        "raw": {
            "AA": "Zulu",
